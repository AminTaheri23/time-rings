{
  "manifest_version": 3,
  "name": "Time Rings New Tab",
  "version": "1.0.0",
  "description": "A ring clock for every scale of time: seconds, hours, weekdays, months and a 100-year life.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "bookmarks",
    "topSites",
    "favicon"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}